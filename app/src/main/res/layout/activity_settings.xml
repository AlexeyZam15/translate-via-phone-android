<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#1e1e1e">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Debug -->
        <CheckBox
            android:id="@+id/checkDebug"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Debug (показать OCR-рамки)"
            android:textColor="#e0e0e0"
            android:textSize="14sp" />

        <!-- Translate engine -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Движок перевода:"
            android:textColor="#e0e0e0"
            android:textSize="14sp"
            android:textStyle="bold" />

        <Spinner
            android:id="@+id/spinnerTranslateEngine"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp" />

        <!-- Confidence -->
        <TextView
            android:id="@+id/textConfidenceValue"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Порог уверенности: 0%"
            android:textColor="#e0e0e0"
            android:textSize="14sp" />

        <SeekBar
            android:id="@+id/seekConfidence"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="100" />

        <!-- OCR padding -->
        <TextView
            android:id="@+id/textOcrPaddingValue"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Отступ OCR: 0%"
            android:textColor="#e0e0e0"
            android:textSize="14sp" />

        <SeekBar
            android:id="@+id/seekOcrPadding"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="50" />

        <!-- Overlay alpha -->
        <TextView
            android:id="@+id/textOverlayAlphaValue"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Прозрачность фона перевода: 0%"
            android:textColor="#e0e0e0"
            android:textSize="14sp" />

        <SeekBar
            android:id="@+id/seekOverlayAlpha"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="100" />

        <!-- Source language -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Исходный язык:"
            android:textColor="#e0e0e0"
            android:textSize="14sp"
            android:textStyle="bold" />

        <Spinner
            android:id="@+id/spinnerSourceLang"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp" />

        <!-- Target language -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Язык перевода:"
            android:textColor="#e0e0e0"
            android:textSize="14sp"
            android:textStyle="bold" />

        <Spinner
            android:id="@+id/spinnerTargetLang"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp" />

        <!-- Model status -->
        <TextView
            android:id="@+id/textModelStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Модель перевода: проверка…"
            android:textColor="#e0e0e0"
            android:textSize="13sp" />

        <Button
            android:id="@+id/btnDownloadModel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Скачать модель"
            android:background="#2196F3"
            android:textColor="#ffffff" />

    </LinearLayout>
</ScrollView>